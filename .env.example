# Web search: https://app.tavily.com (free monthly credits)
TAVILY_API_KEY=
# LLM: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Only free NVIDIA models are allowed (must end with :free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM fallback when OpenRouter is rate-limited: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# Live prices from booking sites (Crawl4AI, local browser); 0 = off
LIVE_PRICES=1
# 1 = one LLM request per trip (default, fewest requests); 0 = parallel requests (faster)
LLM_SINGLE_REQUEST=1
